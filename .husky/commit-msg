#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

COMMIT_MSG_FILE="$1"
FIRST_LINE="$(sed -n '1p' "$COMMIT_MSG_FILE")"

if grep -qi '^Co-Authored-By:' "$COMMIT_MSG_FILE"; then
  echo "🔴 Commit message must not include Co-Authored-By trailers."
  exit 1
fi

if ! printf '%s\n' "$FIRST_LINE" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'; then
  echo "🔴 Commit message must use Conventional Commits."
  echo "Example: fix(ci): catch clean-runner failures before push"
  exit 1
fi

echo "✅ Commit message format looks good."
