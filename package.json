{
  "name": "auth-manumu-studio",
  "version": "1.9.1",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "pnpm prisma:generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "exec vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "migration:readiness": "tsx scripts/migration-readiness.ts",
    "migration:readiness:ci": "tsx scripts/migration-readiness.ts --mode ci --database-url \"$MIGRATION_DATABASE_URL\" --confirm-database \"$MIGRATION_DATABASE_NAME\" --shadow-database-url \"$MIGRATION_SHADOW_DATABASE_URL\"",
    "test:db:gated-registration": "ADMIN_MFA_SECRET_ENCRYPTION_KEYS='{\"1\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}' ADMIN_MFA_SECRET_KEY_VERSION=1 tsx scripts/gated-registration-db-integration.ts",
    "migration:rollback:schema": "tsx scripts/migration-readiness.ts --mode schema-rollback --database-url \"$MIGRATION_DATABASE_URL\" --confirm-database \"$MIGRATION_DATABASE_NAME\" --shadow-database-url \"$MIGRATION_SHADOW_DATABASE_URL\" --run-id \"$MIGRATION_RUN_ID\" --app-rollback-evidence-json \"$APP_ROLLBACK_EVIDENCE_JSON\"",
    "migration:status:live": "tsx scripts/migration-readiness.ts --mode live --database-url \"$MIGRATION_DATABASE_URL\" --confirm-database \"$MIGRATION_DATABASE_NAME\"",
    "release:preflight": "tsx scripts/release-preflight.ts",
    "env:preflight": "tsx scripts/release-preflight.ts",
    "db:seed": "tsx prisma/seed.ts",
    "admin:mfa:bootstrap": "tsx scripts/admin-mfa-bootstrap.ts",
    "smoke": "tsx -e \"fetch('http://localhost:3000/api/healthz').then(r=>r.text()).then(console.log)\"",
    "e2e:built-auth": "tsx scripts/built-auth-golden-path.ts",
    "scaffold:verify": "APPLY=1 ./verify-email-scaffold.sh",
    "prepare": "husky install"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@prisma/client": "^6.16.3",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.34.9",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.23.22",
    "next": "^15.5.19",
    "next-auth": "^4.24.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.1.2",
    "sass": "^1.93.0",
    "zod": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "defu": ">=6.1.7",
      "effect": ">=3.21.4",
      "preact": ">=10.29.2",
      "immutable": ">=5.1.6",
      "minimatch@<3.1.5": "3.1.5",
      "minimatch@>=9.0.0 <9.0.9": "9.0.9",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "flatted": ">=3.4.2",
      "rollup@<4.59.0": "4.62.2",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "postcss": "8.5.15"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.36.0",
    "@next/eslint-plugin-next": "^15.5.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/ui": "^3.2.6",
    "autoprefixer": "^10.4.23",
    "dotenv": "^17.2.3",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.19",
    "globals": "^16.4.0",
    "husky": "^8.0.0",
    "postcss": "^8.5.15",
    "prisma": "^6.16.3",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "yaml": "^2.8.3"
  }
}
